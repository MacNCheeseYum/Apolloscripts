styleElement(resetBtn)

-- 6. Button Logic
local wsEnabled, jpEnabled, flyEnabled = false, false, false
local bodyVelocity, bodyGyro

wsToggle.MouseButton1Click:Connect(function() 
    wsEnabled = not wsEnabled 
    wsToggle.Text = wsEnabled and "WS ON" or "WS OFF" 
    if not wsEnabled and player.Character and player.Character:FindFirstChild("Humanoid") then player.Character.Humanoid.WalkSpeed = 16 end
end)

jpToggle.MouseButton1Click:Connect(function() 
    jpEnabled = not jpEnabled 
    jpToggle.Text = jpEnabled and "JP ON" or "JP OFF" 
    if not jpEnabled and player.Character and player.Character:FindFirstChild("Humanoid") then player.Character.Humanoid.JumpPower = 50 end
end)

flyToggle.MouseButton1Click:Connect(function()
    flyEnabled = not flyEnabled
    flyToggle.Text = flyEnabled and "FLY ON" or "FLY OFF"
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    
    if flyEnabled and root then
        bodyVelocity = Instance.new("BodyVelocity", root)
        bodyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        bodyGyro = Instance.new("BodyGyro", root)
        bodyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    else
        if bodyVelocity then bodyVelocity:Destroy() end
        if bodyGyro then bodyGyro:Destroy() end
        if char and char:FindFirstChild("Humanoid") then char.Humanoid.PlatformStand = false end
    end
end)

resetBtn.MouseButton1Click:Connect(function() 
    if player.Character and player.Character:FindFirstChild("Humanoid") then player.Character.Humanoid.Health = 0 end 
end)

-- 7. Main Loop (Fly Math & Stats)
RunService.Heartbeat:Connect(function()
    local char = player.Character
    local hum = char and char:FindFirstChild("Humanoid")
    local root = char and char:FindFirstChild("HumanoidRootPart")
    
    if hum and root then
        -- Apply WS / JP
        if wsEnabled then hum.WalkSpeed = tonumber(wsInput.Text) or 16 end
        if jpEnabled then hum.JumpPower = tonumber(jpInput.Text) or 50 end
        
        -- Fly Logic
        if flyEnabled and bodyVelocity and bodyGyro then
            hum.PlatformStand = true -- Stops normal walking physics from interrupting flight
            local speed = hum.WalkSpeed * 2 -- Fly a bit faster than walking
            local moveDir = hum.MoveDirection
            
            -- Calculate if player is pushing joystick forward/backward to apply camera pitch
            local camXZ = Vector3.new(camera.CFrame.LookVector.X, 0, camera.CFrame.LookVector.Z)
            local yVelocity = 0
            if camXZ.Magnitude > 0 then
                camXZ = camXZ.Unit
                local forwardAlignment = moveDir:Dot(camXZ) -- 1 if forward, -1 if backward
                yVelocity = camera.CFrame.LookVector.Y * forwardAlignment * speed
            end
            
            bodyVelocity.Velocity = Vector3.new(moveDir.X * speed, yVelocity, moveDir.Z * speed)
            bodyGyro.CFrame = camera.CFrame
        end
    end
end)

-- 8. Dragging Logic (Fixed)
local dragging, dragStart, startPos
dragHandle.InputBegan:Connect(function(input) 
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = frame.Position
    end 
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)
