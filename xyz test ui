local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local camera = workspace.CurrentCamera

-- 1. Create Main UI Container
local screenGui = Instance.new("ScreenGui", playerGui)
screenGui.Name = "TeleportGui"
screenGui.ResetOnSpawn = false

local frame = Instance.new("Frame", screenGui)
frame.Size = UDim2.new(0, 240, 0, 420)
frame.Position = UDim2.new(0.5, -120, 0.5, -210)
frame.BackgroundColor3 = Color3.fromRGB(35, 35, 35) -- Dark Grey Base
Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 12)

-- 2. Styling Helper Function (Purple buttons, Black text, Rounded corners)
local function styleElement(el)
    el.BackgroundColor3 = Color3.fromRGB(150, 60, 210) -- Fancy Purple
    if el:IsA("TextButton") or el:IsA("TextBox") then
        el.TextColor3 = Color3.new(0, 0, 0) -- Black Text
        el.Font = Enum.Font.GothamBold
        el.TextSize = 14
    end
    Instance.new("UICorner", el).CornerRadius = UDim.new(0, 8)
end

-- 3. Drag Handle (Top Bar)
local dragHandle = Instance.new("Frame", frame)
dragHandle.Size = UDim2.new(1, 0, 0, 35)
dragHandle.BackgroundColor3 = Color3.fromRGB(70, 20, 100) -- Darker Purple
Instance.new("UICorner", dragHandle).CornerRadius = UDim.new(0, 12)

local closeBtn = Instance.new("TextButton", dragHandle)
closeBtn.Text = "X"
closeBtn.Size = UDim2.new(0, 35, 1, 0)
closeBtn.Position = UDim2.new(1, -35, 0, 0)
closeBtn.BackgroundColor3 = Color3.fromRGB(220, 50, 50) -- Red X
closeBtn.TextColor3 = Color3.new(0,0,0)
Instance.new("UICorner", closeBtn).CornerRadius = UDim.new(0, 12)
closeBtn.MouseButton1Click:Connect(function() screenGui:Destroy() end)

-- Open/Close Menu Button
local openBtn = Instance.new("TextButton", screenGui)
openBtn.Text = "MENU"
openBtn.Size = UDim2.new(0, 70, 0, 45)
openBtn.Position = UDim2.new(0, 10, 0, 50)
styleElement(openBtn)
openBtn.MouseButton1Click:Connect(function() frame.Visible = not frame.Visible end)

-- 4. Player List (Fixed and Styled)
local scrollList = Instance.new("ScrollingFrame", frame)
scrollList.Size = UDim2.new(1, -20, 0.35, 0)
scrollList.Position = UDim2.new(0, 10, 0, 45)
scrollList.BackgroundTransparency = 1
scrollList.ScrollBarThickness = 4
local listLayout = Instance.new("UIListLayout", scrollList)
listLayout.Padding = UDim.new(0, 5)

local function updateList()
    -- Clear old buttons
    for _, child in pairs(scrollList:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    -- Add current players
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= player then
            local btn = Instance.new("TextButton", scrollList)
            btn.Text = " " .. p.DisplayName
            btn.TextXAlignment = Enum.TextXAlignment.Left
            btn.Size = UDim2.new(1, -5, 0, 30)
            styleElement(btn)
            btn.MouseButton1Click:Connect(function()
                if p.Character and p.Character:FindFirstChild("HumanoidRootPart") and player.Character then
                    player.Character.HumanoidRootPart.CFrame = p.Character.HumanoidRootPart.CFrame * CFrame.new(0, 0, 2)
                end
            end)
        end
    end
end
Players.PlayerAdded:Connect(updateList)
Players.PlayerRemoving:Connect(updateList)
updateList() -- Call immediately to populate list

