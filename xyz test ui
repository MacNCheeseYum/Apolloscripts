wsInput.Position = UDim2.new(0, 10, 0.5, 0)
styleElement(wsInput)

local wsToggle = Instance.new("TextButton", frame)
wsToggle.Text = "WS OFF"
wsToggle.Size = UDim2.new(0.45, 0, 0, 30)
