jpInput.Position = UDim2.new(0, 10, 0.6, 0)
styleElement(jpInput)

local jpToggle = Instance.new("TextButton", frame)
jpToggle.Text = "JP OFF"
jpToggle.Size = UDim2.new(0.45, 0, 0, 30)
jpToggle.Position = UDim2.new(0.5, 2, 0.6, 0)
styleElement(jpToggle)

local flyToggle = Instance.new("TextButton", frame)
flyToggle.Text = "FLY OFF"
flyToggle.Size = UDim2.new(1, -20, 0, 35)
